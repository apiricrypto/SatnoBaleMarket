# SATNO Bale Market Intelligence v0.5 Staff Edition
# Copy to .env.local on the server. Never commit the real file.

DATABASE_PATH=satno_market.db

# Bale sync secret - server-side only
BALE_TOKEN=
BALE_MAX_CHATS=500
BALE_MESSAGES_PER_CHAT=200

# Local HTTP test: 0
# Production HTTPS behind market.satnoco.ir: 1
SESSION_COOKIE_SECURE=0

# SATNO CRM Alpha 2.2 connector preparation.
# Keep both values server-side only. Leave URL empty until Alpha 2.2 is explicitly enabled.
# Expected endpoint shape: https://<supabase-project>/functions/v1/ingest_leads
SATNO_CRM_LEAD_URL=
SATNO_BALE_MARKET_INGEST_TOKEN=
SATNO_CRM_MAX_ATTEMPTS=3
